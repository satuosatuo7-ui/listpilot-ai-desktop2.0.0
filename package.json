{
  "name": "listpilot-desktop",
  "productName": "ListPilot AI",
  "version": "1.0.0",
  "private": true,
  "description": "ListPilot AI official Windows desktop client",
  "author": "ListPilot",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "smoke:win": "node test/windows-smoke.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "app.listpilot.desktop",
    "productName": "ListPilot AI",
    "asar": true,
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**/*", "build/icon.png", "package.json", "!**/*.test.*", "!**/.env*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "ListPilot-AI-Setup-${version}-${arch}.${ext}",
      "executableName": "ListPilot AI"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ListPilot AI",
      "uninstallDisplayName": "ListPilot AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": ["zh_CN", "en_US"]
    }
  }
}